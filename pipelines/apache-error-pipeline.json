{
  "description": "Pipeline de traitement des logs d'erreur Apache",
  "processors": [
    {
      "grok": {
        "field": "message",
        "patterns": [
          "\\[%{APACHE_TIME:apache.error.timestamp}\\] \\[%{WORD:log.level}\\]( \\[pid %{NUMBER:process.pid:int}(:tid %{NUMBER:process.thread.id:int})?\\])?( \\[client %{IPORHOST:source.ip}(:%{POSINT:source.port:int})?\\])? %{GREEDYDATA:message}"
        ],
        "pattern_definitions": {
          "APACHE_TIME": "%{DAY} %{MONTH} %{MONTHDAY} %{TIME} %{YEAR}"
        }
      }
    },
    {
      "date": {
        "field": "apache.error.timestamp",
        "target_field": "@timestamp",
        "formats": [
          "EEE MMM dd HH:mm:ss yyyy",
          "EEE MMM dd HH:mm:ss.SSSSSS yyyy"
        ],
        "ignore_failure": true
      }
    },
    {
      "remove": {
        "field": [
          "apache.error.timestamp"
        ],
        "ignore_missing": true
      }
    }
  ]
}
